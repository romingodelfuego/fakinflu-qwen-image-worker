{
  "name": "comfyui",
  "repo": "romingodelfuego/fakinflu-qwen-image-worker",
  "visibility": "public",
  "description": "fakinflu RunPod serverless worker: ComfyUI 0.37 + Qwen-Image 2.1 Edit (models baked)",
  "endpoint": {
    "name": "fakinflu-qwen-image-worker",
    "env_var": "RUNPOD_COMFYUI_QWEN_ENDPOINT_ID",
    "gpu_pools": [
      "AMPERE_16",
      "AMPERE_24"
    ],
    "workers": {
      "min": 0,
      "max": 3,
      "idleTimeout": 3
    },
    "timeout_ms": 600000,
    "flashboot": "OFF",
    "disk_gb": 5,
    "env": {}
  },
  "version": "v1.0.0"
}
